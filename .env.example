# ============================================================
#  AICTE Nutrition Agent — Environment Configuration TEMPLATE
#  Copy this file to .env and fill in your credentials
# ============================================================

# ------------------------------------------------------------------
# IBM watsonx.ai (REQUIRED)
# Get credentials: https://cloud.ibm.com/iam/apikeys
# ------------------------------------------------------------------
IBM_API_KEY=your_ibm_api_key_here
IBM_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ------------------------------------------------------------------
# IBM Granite Model Selection (CHAT models — uses chat() API, not generate_text())
# These are the models confirmed available on watsonx.ai:
#   ibm/granite-4-h-small                               (IBM-native, recommended)
#   meta-llama/llama-3-3-70b-instruct
#   meta-llama/llama-4-maverick-17b-128e-instruct-fp8
#   mistral-large-2512
#   mistralai/mistral-medium-2505
#   mistralai/mistral-small-3-1-24b-instruct-2503
#   openai/gpt-oss-120b
# ------------------------------------------------------------------
GRANITE_MODEL_ID=ibm/granite-4-h-small

# ------------------------------------------------------------------
# USDA FoodData Central API (OPTIONAL but recommended)
# Free key: https://fdc.nal.usda.gov/api-guide.html
# ------------------------------------------------------------------
USDA_API_KEY=your_usda_api_key_here

# ------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ------------------------------------------------------------------
# Streamlit Frontend
# ------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
